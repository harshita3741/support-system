# ── SQL Server ──────────────────────────────────────────────────────────────
# SA (System Administrator) password — must meet SQL Server complexity rules:
#   8+ chars, upper + lower + digit + symbol
MSSQL_SA_PASSWORD=Change_Me_SA!123

# Application DB user password (set the same value in Spring config)
DB_APP_PASSWORD=Change_Me_App!456

# ── Backend URL ──────────────────────────────────────────────────────────────
# The public URL of the Spring Boot backend as seen by browsers.
# This is injected into both Angular apps at container start time.
# Example for a server with IP 203.0.113.10:
#   API_URL=http://203.0.113.10:8080
# Example for a domain name:
#   API_URL=https://api.yourdomain.com
API_URL=http://YOUR_SERVER_IP:8080
